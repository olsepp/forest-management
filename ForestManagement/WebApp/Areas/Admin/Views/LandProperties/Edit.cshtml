@using App.Contracts.Enums
@using App.Domain
@using WebApp.Models
@model LandPropertyCreateEditViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>LandProperty</h4>
<hr />
