@model IEnumerable<App.Domain.Cadaster>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CadastralNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ForestArea)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ArableArea)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GrasslandArea)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.YardArea)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BuildingFootprintArea)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UnderwaterArea)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OtherArea)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SoilQualityIndex)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CalculatedVolume)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VolumeGrowth)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LandProperty)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CadastralNumber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ForestArea)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ArableArea)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GrasslandArea)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.YardArea)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BuildingFootprintArea)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UnderwaterArea)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OtherArea)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SoilQualityIndex)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CalculatedVolume)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.VolumeGrowth)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LandProperty.Name)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
