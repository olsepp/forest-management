FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci
COPY frontend/ ./
RUN rm -f .env
ENV PUBLIC_API_URL=
RUN npm run build

FROM node:22-alpine
WORKDIR /app
COPY --from=build /app/package.json /app/package-lock.json* ./
RUN npm ci --omit dev
COPY --from=build /app/build ./build
ENV PORT=3000
EXPOSE 3000
CMD ["node", "build/index.js"]
